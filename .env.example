DATABASE_URL=
AUTH_USERNAME=
AUTH_PASSWORD=
AUTH_SECRET=
# URL of a Gotenberg instance (LibreOffice route) for PDF downloads. Optional —
# without it, invoices/payslips still download as .docx/.xlsx.
GOTENBERG_URL=
# WhatsApp overdue-invoice notifications via a self-hosted Evolution API
# (https://doc.evolution-api.com/). URL is the instance base (no trailing slash),
# KEY is the global or instance apikey, INSTANCE is the connected instance name,
# TARGET_NUMBER is YOUR OWN number (country code, no +/spaces) to notify.
# All four optional; without them /api/cron/notify-overdue just skips sending.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
EVOLUTION_TARGET_NUMBER=
# Shared secret an external scheduler (Vercel Cron, cron-job.org, Windows Task
# Scheduler, ...) must pass as ?secret= to call /api/cron/notify-overdue.
CRON_SECRET=
