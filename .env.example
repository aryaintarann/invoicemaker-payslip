DATABASE_URL=
AUTH_USERNAME=
AUTH_PASSWORD=
AUTH_SECRET=
# URL of a Gotenberg instance (LibreOffice route) for PDF downloads. Optional —
# without it, invoices/payslips still download as .docx/.xlsx.
GOTENBERG_URL=
# WhatsApp overdue-invoice notifications via CallMeBot (https://www.callmebot.com/).
# CALLMEBOT_PHONE is YOUR OWN number (with country code, no +/spaces) that has
# opted in to CallMeBot; CALLMEBOT_APIKEY is the key it gave you when you did.
# Notifies you, not the client - see lib/callmebot.ts. Optional; without them
# /api/cron/notify-overdue just skips sending.
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=
# Shared secret an external scheduler (Vercel Cron, cron-job.org, Windows Task
# Scheduler, ...) must pass as ?secret= to call /api/cron/notify-overdue.
CRON_SECRET=
